# Application Settings
APP_NAME=payments
PORT=8083
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (Payments-specific PostgreSQL on port 5434)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payments

# RabbitMQ Configuration (SHARED across ALL services - use the one from orders)
# All microservices connect to the SAME RabbitMQ instance for event communication
# Start RabbitMQ from the orders service: cd ../orders && docker-compose up -d rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=basebandit.events

# Payment Gateway Configuration
# Success rate for mock payment gateway (0.0 to 1.0, default: 0.9 = 90% success)
PAYMENT_GATEWAY_SUCCESS_RATE=0.9
