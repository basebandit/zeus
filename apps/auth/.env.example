PORT=8084

# Database
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth

# RabbitMQ (shared broker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=basebandit.events

# JWT (HS256, must be >= 32 bytes and match the gateway's JWT_SECRET)
JWT_SECRET=dev-insecure-jwt-secret-change-me-in-prod-0123456789
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
