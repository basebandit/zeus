# Server Configuration
PORT=8082
HOST=0.0.0.0
ENV=development

# Database Configuration (Inventory-specific PostgreSQL on port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inventory
DB_SSLMODE=disable

# Migration Configuration
# Set to "true" to run migrations on startup (development only)
# In production, run migrations via CLI: make migrate-up
RUN_MIGRATIONS_ON_STARTUP=true

# RabbitMQ Configuration (SHARED across ALL services - use the one from orders)
# All microservices connect to the SAME RabbitMQ instance for event communication
# Start RabbitMQ from the orders service: cd ../orders && docker-compose up -d rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=basebandit.events

# Redis Configuration (Inventory-specific Redis on port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
