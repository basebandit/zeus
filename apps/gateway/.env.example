PORT=8081
HOST=0.0.0.0
ENV=development

# Must match the value used by the auth service to sign JWTs (HS256 requires >= 32 bytes).
JWT_SECRET=dev-insecure-jwt-secret-change-me-in-prod-0123456789

# Allowed browser origin for CORS (the web app).
WEB_ORIGIN=http://localhost:3000

# Upstream service base URLs.
AUTH_URL=http://localhost:8084
ORDERS_URL=http://localhost:8080
INVENTORY_URL=http://localhost:8082
PAYMENTS_URL=http://localhost:8083
SHIPPING_URL=http://localhost:8085
