APP_NAME=shipping
PORT=8085
HOST=0.0.0.0
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5437
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shipping

# RabbitMQ (shared broker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=basebandit.events

# Default carrier name used on shipments
CARRIER=ZeusExpress
